<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent manages versions for Spring, Kafka clients, Jackson, Flyway,
         the PostgreSQL driver and Testcontainers, so modules declare dependencies without versions. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.simms11</groupId>
    <artifactId>payment-settlement-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Payment Settlement Engine</name>
    <description>Choreographed saga of payment services communicating via Kafka, using the transactional outbox and Debezium CDC</description>

    <modules>
        <!-- Added as each module is created: payment-contracts, payment-gateway, compliance-service, core-ledger -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <!-- Surefire runs *Test classes on `mvn test`.
                 Failsafe runs *IT classes on `mvn verify` (executions are pre-configured by the Boot parent),
                 so the fast unit tests never wait on Docker. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
